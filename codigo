CREATE DATABASE tienda_abarrotes;

USE tienda_abarrotes;

CREATE TABLE tb_tienda (
    id_tienda INT PRIMARY KEY,
    nombre VARCHAR(30),
    direccion VARCHAR(50),
    horario VARCHAR(30)
);

CREATE TABLE tb_proveedor (
    id_proveedor INT PRIMARY KEY,
    nombre VARCHAR(30),
    telefono VARCHAR(20),
    direccion VARCHAR(50)
);

CREATE TABLE tb_cliente (
    id_cliente INT PRIMARY KEY,
    nombre VARCHAR(30),
    NO_doc VARCHAR(20),
    tipo_doc VARCHAR(20),
    telefono VARCHAR(20),
    direccion VARCHAR(50)
);

CREATE TABLE tb_producto (
    id_producto INT PRIMARY KEY,
    nombre VARCHAR(30),
    categoria VARCHAR(30),
    precio DECIMAL(10,2),
    cantidad_producto INT
);

CREATE TABLE tb_factura (
    id_venta INT PRIMARY KEY,
    total DECIMAL(10,2),
    fecha_venta DATE
);

CREATE TABLE tb_detalle_factura (
    id_detalle INT PRIMARY KEY,
    cantidad INT,
    subtotal DECIMAL(10,2)
);


-- RELACION TIENDA - PRODUCTO

ALTER TABLE tb_producto
ADD id_tienda INT;

ALTER TABLE tb_producto
ADD CONSTRAINT fk_tienda_producto
FOREIGN KEY (id_tienda)
REFERENCES tb_tienda(id_tienda)
ON UPDATE CASCADE
ON DELETE RESTRICT;


-- RELACION PROVEEDOR - PRODUCTO

ALTER TABLE tb_producto
ADD id_proveedor INT;

ALTER TABLE tb_producto
ADD CONSTRAINT fk_proveedor_producto
FOREIGN KEY (id_proveedor)
REFERENCES tb_proveedor(id_proveedor)
ON UPDATE CASCADE
ON DELETE RESTRICT;


-- RELACION CLIENTE - FACTURA

ALTER TABLE tb_factura
ADD id_cliente INT;

ALTER TABLE tb_factura
ADD CONSTRAINT fk_cliente_factura
FOREIGN KEY (id_cliente)
REFERENCES tb_cliente(id_cliente)
ON UPDATE CASCADE
ON DELETE RESTRICT;


-- RELACION TIENDA - FACTURA

ALTER TABLE tb_factura
ADD id_tienda INT;

ALTER TABLE tb_factura
ADD CONSTRAINT fk_tienda_factura
FOREIGN KEY (id_tienda)
REFERENCES tb_tienda(id_tienda)
ON UPDATE CASCADE
ON DELETE RESTRICT;


-- RELACION FACTURA - DETALLE_FACTURA

ALTER TABLE tb_detalle_factura
ADD id_venta INT;

ALTER TABLE tb_detalle_factura
ADD CONSTRAINT fk_factura_detalle
FOREIGN KEY (id_venta)
REFERENCES tb_factura(id_venta)
ON UPDATE CASCADE
ON DELETE RESTRICT;


-- RELACION PRODUCTO - DETALLE_FACTURA

ALTER TABLE tb_detalle_factura
ADD id_producto INT;

ALTER TABLE tb_detalle_factura
ADD CONSTRAINT fk_producto_detalle
FOREIGN KEY (id_producto)
REFERENCES tb_producto(id_producto)
ON UPDATE CASCADE
ON DELETE RESTRICT;

